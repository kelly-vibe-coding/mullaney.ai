# Upstash Redis credentials for Shorts like/dislike votes.
# Votes degrade gracefully: with none of these set, the vote API returns 503 and
# the UI shows zero counts. The feed still renders. See lib/votes/redis.ts.

# Classic Upstash Redis (console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Marketplace Upstash integration sets these instead; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
